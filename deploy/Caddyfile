{
	admin off
	metrics
	servers :80 {
		name edge_http
	}
	servers :443 {
		name edge_https
	}
	servers :9180 {
		name monitoring
	}
	log {
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
			}
		}
	}
}

:9180 {
	metrics /metrics
}

{$SITE_ADDRESS} {
	log {
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
				user_id delete
			}
		}
	}

	route {
		vars request_id {http.request.uuid}
		log_append <request_id {vars.request_id}
		header X-Request-ID {vars.request_id}
		encode zstd gzip

		@metrics path /metrics /metrics/* /_metrics /_metrics/*
		respond @metrics 404

		@django path /api/* /admin*
		handle @django {
			reverse_proxy web:8000 {
				header_up X-FoodTinder-Client-IP {remote_host}
				header_up X-Request-ID {vars.request_id}
				header_down -X-Request-ID
			}
		}
		handle_path /static/* {
			root * /srv/static
			file_server
		}
		handle_path /media/* {
			root * /srv/media
			file_server
		}
		handle {
			root * /srv/frontend
			try_files {path} /index.html
			file_server
		}
	}
}
