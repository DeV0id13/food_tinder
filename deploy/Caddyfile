{
    admin off
}

{$SITE_ADDRESS} {
    encode zstd gzip

    @django path /api/* /admin*
    handle @django {
        reverse_proxy web:8000 {
            header_up X-FoodTinder-Client-IP {remote_host}
        }
    }
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    handle_path /media/* {
        root * /srv/media
        file_server
    }
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
