{
  "uid": "foodtinder",
  "title": "FoodTinder · RED / USE",
  "tags": [
    "FoodTinder"
  ],
  "description": "RED приложения и ресурсы VM. Caddy включает API, HTML, статику и медиа. Django API показан отдельно, складывать два ряда нельзя. Окно rate 2 минуты.",
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "20s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Запросы HTTP и API",
      "description": "API входит в общий HTTP-трафик Caddy. Прямые внутренние readiness-запросы видны только в Django.",
      "datasource": {
        "type": "prometheus",
        "uid": "foodtinder-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(caddy_http_requests_total[2m]))",
          "legendFormat": "Caddy · весь HTTP",
          "datasource": {
            "type": "prometheus",
            "uid": "foodtinder-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(foodtinder_api_requests_total[2m]))",
          "legendFormat": "Django · API",
          "datasource": {
            "type": "prometheus",
            "uid": "foodtinder-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Успешные ответы 2xx",
      "description": "2xx / все ответы. Перенаправления входят в знаменатель. При нулевом знаменателе доля не определена.",
      "datasource": {
        "type": "prometheus",
        "uid": "foodtinder-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(caddy_http_request_duration_seconds_count{code=~\"2..\"}[2m])) or (0 * sum(rate(caddy_http_request_duration_seconds_count[2m])))) / sum(rate(caddy_http_request_duration_seconds_count[2m]))",
          "legendFormat": "Caddy",
          "datasource": {
            "type": "prometheus",
            "uid": "foodtinder-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(sum(rate(foodtinder_api_requests_total{status=\"2xx\"}[2m])) or (0 * sum(rate(foodtinder_api_requests_total[2m])))) / sum(rate(foodtinder_api_requests_total[2m]))",
          "legendFormat": "Django API",
          "datasource": {
            "type": "prometheus",
            "uid": "foodtinder-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ошибки HTTP · Caddy",
      "description": "Серверные ответы. Клиентские тайм-ауты k6 измеряются на генераторе.",
